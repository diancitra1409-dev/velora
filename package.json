{
  "name": "velora",
  "version": "1.0.0",
  "private": true,
  "description": "Velora — AI Book Search Engine & Literary Assistant",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"indigo,amber\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
